# JarvisCore project. Run locally with `jarviscore dev`.
# Docs: https://jarviscore.developers.prescottdata.io/
service: {{service}}

agents:
  triage:
    path: agents/triage.py
  responder:
    path: agents/responder.py
    hitl: true

env:
  clear:
    LOG_LEVEL: INFO
  secret: {{secret_list}}

