[project]
name = "{{service}}"
version = "0.1.0"
requires-python = ">=3.10"
dependencies = [
    "jarviscore-framework[p2p,redis]>={{jarviscore_version}}",
]

[project.optional-dependencies]
dev = [
    "pytest>=7.4",
    "pytest-asyncio>=0.21",
]

[tool.uv]
package = false
{{framework_source}}
[tool.pytest.ini_options]
testpaths = ["tests"]
asyncio_mode = "auto"
